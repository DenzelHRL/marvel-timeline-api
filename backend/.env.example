# Development only. Copy to .env, then change passwords before sharing access.
DB_HOST=localhost
DB_PORT=5432
DB_USER=marvel
DB_PASSWORD=marvel_dev_only
DB_NAME=marvel_timeline

# Banco hospedado: substitua as cinco variáveis DB_* acima por DATABASE_URL no seu .env.
# Use somente o endereço privado fornecido pelo serviço; não publique a URL nem a senha.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Only used if you explicitly enable demo accounts locally.
SEED_DEMO_USERS=false
DEMO_ADMIN_PASSWORD=
DEMO_READER_PASSWORD=
