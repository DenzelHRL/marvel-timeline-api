# Somente para desenvolvimento. Copie para .env e altere as senhas antes de compartilhar o acesso.
DB_HOST=localhost
DB_PORT=5432
DB_USER=marvel
DB_PASSWORD=marvel_dev_only
DB_NAME=marvel_timeline

# Gere um valor exclusivo para seu ambiente com o resultado abaixo. Não compartilhe nem envie este segredo ao Git.
JWT_SECRET= # node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Banco hospedado: substitua as cinco variáveis DB_* acima por DATABASE_URL no seu .env.
# Use a URL externa no seu PC e a URL interna no serviço hospedado; não publique credenciais.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Usado somente se você habilitar explicitamente contas de demonstração locais.
SEED_DEMO_USERS=false
DEMO_ADMIN_PASSWORD=
DEMO_READER_PASSWORD=
